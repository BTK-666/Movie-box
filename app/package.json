{
  "name": "moviebox-plus",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "tsc --noEmit",
    "test:unit": "node tests/run-unit.mjs",
    "test:ui": "node tests/ui.spec.mjs",
    "test:apk": "node tests/apkpayload.mjs",
    "test": "npm run test:unit && npm run test:media && npm run test:e2e && npm run test:e2e:series && npm run test:ui",
    "test:media": "node tests/webview-media.mjs",
    "test:e2e": "node tests/e2e-playback.mjs",
    "test:e2e:series": "node tests/e2e-series.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/screen-orientation": "^8.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "playwright": "^1.64.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "ws": "^8.22.1"
  }
}
